# Vendored IEEE Access template (class, fonts, maps, logos) lives in access-template/.
ensure_path('TEXINPUTS', './access-template//');
ensure_path('TFMFONTS', './access-template//');
ensure_path('T1FONTS', './access-template//');
ensure_path('TEXFONTMAPS', './access-template//');
ensure_path('ENCFONTS', './access-template//');

# Float check (Pedro, 2026-10-18): every table and figure must come after its first reference in the running
# text, at the nearest place after it. tools/check_floats.py reads the PDF after every build (also
# `make check-floats`); any violation (before the reference, or too far after it) makes latexmk fail.
END {
  my $status = $?;
  my $pdf = ($out_dir ? "$out_dir/" : '') . 'main.pdf';
  if (!$cleanup_mode && -e $pdf && -e 'tools/check_floats.py') {
    my $py = -x '/usr/bin/python3' ? '/usr/bin/python3' : 'python3';
    my $rc = system($py, 'tools/check_floats.py', $pdf);
    $? = ($rc != 0 && $status == 0) ? 1 : $status;
  } else {
    $? = $status;
  }
}
